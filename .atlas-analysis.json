  "keyFeatures": [
    "OpenAI-compatible chat completions API",
    "Anthropic Messages API compatibility",
    "Text-to-speech with multiple voice providers",
    "Image generation via OpenAI and Volink protocols",
    "Streaming support via server-sent events",
    "Tool/function calling support",
    "Custom voice creation (mix, text-designed, clone)",
    "Single API key for all providers and models",
    "Integrations with AI agents, chat platforms, and role-play apps",
    "Points-based billing with usage tracking"
